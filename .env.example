# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Инстанс mempool: публичный или свой (REST = $MEMPOOL_URL/api, WS = $MEMPOOL_URL/api/v1/ws)
MEMPOOL_URL=https://mempool.space
# MEMPOOL_API=https://mempool.space/api
# MEMPOOL_WS=wss://mempool.space/api/v1/ws

# Курс ЦБ РФ (JSON) для пересчёта сумм в рубли: BTC/RUB = BTC/USD × USD/RUB
# RUB_RATE_URL=https://www.cbr-xml-daily.ru/daily_json.js

# Страховочный опрос всех адресов через REST (WebSocket даёт события мгновенно)
POLL_INTERVAL_SEC=60
# Пауза между запросами к REST API, мс (защита от rate limit)
REQUEST_GAP_MS=250

# Где хранить подписки
DATA_FILE=data/state.json
MAX_ADDRESSES_PER_CHAT=20

# Telegram user id через запятую; пусто = бот доступен всем
ALLOWED_USER_IDS=

# Ссылка на исходники в справке, настройках и описании бота
# SOURCE_URL=https://github.com/stlr00/BTC-CHECKER-BOT
