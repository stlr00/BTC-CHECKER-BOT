# Нужен хотя бы один мессенджер.
# Telegram: токен от @BotFather. Пусто — Telegram выключен
BOT_TOKEN=

# VK: ключ доступа сообщества с правом «Сообщения сообщества». Пусто — VK выключен.
# В сообществе: Сообщения — вкл.; Возможности ботов — вкл.;
# Работа с API → Long Poll API — вкл., версия 5.199, события «Входящее сообщение» и «Действие с сообщением»
VK_TOKEN=
# ID сообщества (число из club123). Необязательно: бот определит его по ключу
# VK_GROUP_ID=

# Инстанс mempool: публичный или свой (REST = $MEMPOOL_URL/api, WS = $MEMPOOL_URL/api/v1/ws)
MEMPOOL_URL=https://mempool.space
# MEMPOOL_API=https://mempool.space/api
# MEMPOOL_WS=wss://mempool.space/api/v1/ws

# Курс ЦБ РФ (JSON) для пересчёта сумм в рубли: BTC/RUB = BTC/USD × USD/RUB
# RUB_RATE_URL=https://www.cbr-xml-daily.ru/daily_json.js

# Страховочный опрос всех адресов через REST (WebSocket даёт события мгновенно)
POLL_INTERVAL_SEC=60
# Пауза между запросами к REST API, мс (защита от rate limit)
REQUEST_GAP_MS=250

# Где хранить подписки
DATA_FILE=data/state.json
MAX_ADDRESSES_PER_CHAT=20

# ID пользователей через запятую; пусто = бот на этой платформе доступен всем
ALLOWED_USER_IDS=
ALLOWED_VK_USER_IDS=

# Ссылка на исходники в справке, настройках и описании бота
# SOURCE_URL=https://github.com/stlr00/BTC-CHECKER-BOT

# Yandex Vision OCR + Alice AI LLM — распознавание GPS-координат на фото. Пусто = функция выключена.
# Сервисный аккаунт с ролями ai.vision.user и ai.languageModels.user,
# API-ключ с областями yc.ai.vision.execute и yc.ai.languageModels.execute
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_OCR_URL=https://ai.api.cloud.yandex.net/ocr/v1/recognizeText
# YANDEX_LLM_URL=https://llm.api.cloud.yandex.net/v1/chat/completions
# YANDEX_LLM_MODEL=aliceai-llm
